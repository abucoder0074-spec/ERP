APP_ENV=development
DJANGO_SECRET_KEY=GENERATE_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=GENERATE_DB_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
LOGIN_REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:GENERATE_REDIS_PASSWORD@redis:6379/1
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
SESSION_MAX_AGE=1800
VAT_RATE_PERCENT=12.00
TRUST_PROXY_HTTPS=0
TRUSTED_PROXY_IPS=
WRITE_OFF_LIMIT_UZS=100000
STOCK_EXPIRY_WARNING_DAYS=7
PROCUREMENT_OVER_DELIVERY_PERCENT=5
PROCUREMENT_QUANTITY_MATCH_PERCENT=0
PROCUREMENT_PRICE_MATCH_PERCENT=1
PROCUREMENT_QUARANTINE_DRY=0
PROCUREMENT_QUARANTINE_COLD=1
PROCUREMENT_ATTACHMENT_LIMIT=2097152
PROCUREMENT_SCAN_HOOK=apps.procurement.services.attachments.no_op_scan
